package handler

import (
	"fmt"
	"log"

	"mua/minigame/gomokusvr/internal/pb"
	"mua/minigame/gomokusvr/internal/room"

	"google.golang.org/protobuf/proto"
)

// GameHandler 游戏消息处理器
type GameHandler struct {
	roomManager *room.RoomManager
}

// NewGameHandler 创建新的游戏处理器
func NewGameHandler() *GameHandler {
	return &GameHandler{
		roomManager: room.GetRoomManager(),
	}
}

// notifyOtherPlayers 通知房间内其他玩家
func (h *GameHandler) notifyOtherPlayers(room *room.Room, currentPlayerID string, placeResp *pb.PlacePieceResponse) {
	allPlayers := room.GetAllPlayers()
	for _, playerID := range allPlayers {
		if playerID != currentPlayerID {
			notifyMsg := &pb.GameStateNotify{
				RoomId:       room.ID,
				GameState:    placeResp.GameState,
				EventType:    "MOVE",
				EventMessage: fmt.Sprintf("玩家 %s 下了一步棋", currentPlayerID),
			}

			notifyData, _ := proto.Marshal(notifyMsg)
			log.Printf("推送下棋通知给玩家: %s, 数据大小: %d bytes", playerID, len(notifyData))
		}
	}
}

// notifyGameOver 通知游戏结束
func (h *GameHandler) notifyGameOver(room *room.Room, gameState *pb.GameState) {
	allPlayers := room.GetAllPlayers()

	var eventMessage string
	switch gameState.Result {
	case pb.GameResult_BLACK_WIN:
		eventMessage = "黑子获胜！"
	case pb.GameResult_WHITE_WIN:
		eventMessage = "白子获胜！"
	case pb.GameResult_DRAW:
		eventMessage = "平局！"
	default:
		eventMessage = "游戏结束"
	}

	for _, playerID := range allPlayers {
		notifyMsg := &pb.GameStateNotify{
			RoomId:       room.ID,
			GameState:    gameState,
			EventType:    "GAME_OVER",
			EventMessage: eventMessage,
		}

		notifyData, _ := proto.Marshal(notifyMsg)
		log.Printf("推送游戏结束通知给玩家: %s, 结果: %s, 数据大小: %d bytes", playerID, eventMessage, len(notifyData))
	}
}

// notifyPlayerJoined 通知玩家加入
func (h *GameHandler) notifyPlayerJoined(room *room.Room, joinedPlayerID string) {
	allPlayers := room.GetAllPlayers()
	for _, playerID := range allPlayers {
		if playerID != joinedPlayerID {
			notifyMsg := &pb.PlayerEventNotify{
				RoomId:     room.ID,
				PlayerId:   joinedPlayerID,
				EventType:  "JOIN",
				PlayerInfo: nil,
			}

			notifyData, _ := proto.Marshal(notifyMsg)
			log.Printf("推送玩家加入通知给玩家: %s, 加入者: %s, 数据大小: %d bytes", playerID, joinedPlayerID, len(notifyData))
		}
	}
}

// notifyPlayerLeft 通知玩家离开
func (h *GameHandler) notifyPlayerLeft(room *room.Room, leftPlayerID string) {
	allPlayers := room.GetAllPlayers()
	for _, playerID := range allPlayers {
		if playerID != leftPlayerID {
			notifyMsg := &pb.PlayerEventNotify{
				RoomId:    room.ID,
				PlayerId:  leftPlayerID,
				EventType: "LEAVE",
			}

			notifyData, _ := proto.Marshal(notifyMsg)
			log.Printf("推送玩家离开通知给玩家: %s, 离开者: %s, 数据大小: %d bytes", playerID, leftPlayerID, len(notifyData))
		}
	}
}

// notifyPlayerReady 通知玩家准备状态变化
func (h *GameHandler) notifyPlayerReady(room *room.Room, readyPlayerID string, isReady bool) {
	allPlayers := room.GetAllPlayers()

	// 获取准备玩家的信息
	var playerInfo *pb.PlayerInfo
	roomInfo := room.GetRoomInfo()
	for _, player := range roomInfo.Players {
		if player.PlayerId == readyPlayerID {
			playerInfo = player
			break
		}
	}

	for _, playerID := range allPlayers {
		if playerID != readyPlayerID {
			notifyMsg := &pb.PlayerEventNotify{
				RoomId:     room.ID,
				PlayerId:   readyPlayerID,
				EventType:  "READY",
				PlayerInfo: playerInfo,
			}

			notifyData, _ := proto.Marshal(notifyMsg)
			log.Printf("推送玩家准备状态通知给玩家: %s, 准备者: %s, 状态: %t, 数据大小: %d bytes", playerID, readyPlayerID, isReady, len(notifyData))
		}
	}
}

// structToBytes 结构体转字节
func structToBytes(data proto.Message) []byte {
	bytes, _ := proto.Marshal(data)
	return bytes
}
