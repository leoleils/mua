package handler

import (
	"context"
	"encoding/json"
	"fmt"
	"log"
	"time"

	"mua/minigame/gomokusvr/internal/notification"
	"mua/minigame/gomokusvr/internal/pb"
	"mua/minigame/gomokusvr/internal/room"

	"google.golang.org/protobuf/proto"
)

// GameHandler 游戏消息处理器
type GameHandler struct {
	pb.UnimplementedCommonServiceServer
	roomManager *room.RoomManager
}

// NewGameHandler 创建新的游戏处理器
func NewGameHandler() *GameHandler {
	return &GameHandler{
		roomManager: room.GetRoomManager(),
	}
}

// SendMessage 处理游戏消息
func (h *GameHandler) SendMessage(ctx context.Context, req *pb.GameMessage) (*pb.GameMessageResponse, error) {
	log.Printf("收到消息 - 玩家: %s, 方法: %s", req.Head.PlayerId, req.Head.Method)

	response := &pb.GameMessageResponse{
		Head: &pb.MessageHead{
			MsgId:       req.Head.MsgId,
			PlayerId:    req.Head.PlayerId,
			ServiceName: req.Head.ServiceName,
			Method:      req.Head.Method,
		},
		Timestamp: time.Now().UnixMilli(),
	}

	// 根据方法名分发处理
	switch req.Head.Method {
	case "CreateRoom":
		return h.handleCreateRoom(req, response)
	case "JoinRoom":
		return h.handleJoinRoom(req, response)
	case "LeaveRoom":
		return h.handleLeaveRoom(req, response)
	case "DestroyRoom":
		return h.handleDestroyRoom(req, response)
	case "PlacePiece":
		return h.handlePlacePiece(req, response)
	case "GetRoomList":
		return h.handleGetRoomList(req, response)
	case "StartGame":
		return h.handleStartGame(req, response)
	default:
		response.Code = 400
		response.Message = fmt.Sprintf("未知的方法: %s", req.Head.Method)
		return response, nil
	}
}

// handleCreateRoom 处理创建房间
func (h *GameHandler) handleCreateRoom(req *pb.GameMessage, resp *pb.GameMessageResponse) (*pb.GameMessageResponse, error) {
	var createReq pb.CreateRoomRequest
	if err := proto.Unmarshal(req.Payload, &createReq); err != nil {
		resp.Code = 400
		resp.Message = "参数解析失败"
		return resp, nil
	}

	// 创建房间
	room, err := h.roomManager.CreateRoom(req.Head.PlayerId, createReq.RoomName, createReq.Password)
	if err != nil {
		resp.Code = 500
		resp.Message = err.Error()
		return resp, nil
	}

	// 构造响应
	createResp := &pb.CreateRoomResponse{
		Success: true,
		RoomId:  room.ID,
		Message: "房间创建成功",
	}

	payload, _ := proto.Marshal(createResp)
	resp.Code = 0
	resp.Payload = payload
	resp.Message = "成功"

	log.Printf("房间创建成功 - 玩家: %s, 房间ID: %s", req.Head.PlayerId, room.ID)
	return resp, nil
}

// handleJoinRoom 处理加入房间
func (h *GameHandler) handleJoinRoom(req *pb.GameMessage, resp *pb.GameMessageResponse) (*pb.GameMessageResponse, error) {
	var joinReq pb.JoinRoomRequest
	if err := proto.Unmarshal(req.Payload, &joinReq); err != nil {
		resp.Code = 400
		resp.Message = "参数解析失败"
		return resp, nil
	}

	// 加入房间
	room, err := h.roomManager.JoinRoom(req.Head.PlayerId, joinReq.RoomId, joinReq.Password)
	if err != nil {
		resp.Code = 500
		resp.Message = err.Error()
		return resp, nil
	}

	// 构造响应
	joinResp := &pb.JoinRoomResponse{
		Success:  true,
		Message:  "加入房间成功",
		RoomInfo: room.GetRoomInfo(),
	}

	payload, _ := proto.Marshal(joinResp)
	resp.Code = 0
	resp.Payload = payload
	resp.Message = "成功"

	log.Printf("玩家加入房间成功 - 玩家: %s, 房间ID: %s", req.Head.PlayerId, joinReq.RoomId)

	// 【新增】推送消息给房间内其他玩家
	go h.notifyPlayerJoined(room, req.Head.PlayerId)

	return resp, nil
}

// handleLeaveRoom 处理离开房间
func (h *GameHandler) handleLeaveRoom(req *pb.GameMessage, resp *pb.GameMessageResponse) (*pb.GameMessageResponse, error) {
	var leaveReq pb.LeaveRoomRequest
	if err := proto.Unmarshal(req.Payload, &leaveReq); err != nil {
		resp.Code = 400
		resp.Message = "参数解析失败"
		return resp, nil
	}

	// 先获取房间信息，用于推送通知
	targetRoom := h.roomManager.GetRoom(leaveReq.RoomId)
	if targetRoom != nil {
		// 【新增】推送消息给房间内其他玩家（在离开前推送）
		go h.notifyPlayerLeft(targetRoom, req.Head.PlayerId)
	}

	// 离开房间
	err := h.roomManager.LeaveRoom(req.Head.PlayerId, leaveReq.RoomId)
	if err != nil {
		resp.Code = 500
		resp.Message = err.Error()
		return resp, nil
	}

	// 构造响应
	leaveResp := &pb.LeaveRoomResponse{
		Success: true,
		Message: "离开房间成功",
	}

	payload, _ := proto.Marshal(leaveResp)
	resp.Code = 0
	resp.Payload = payload
	resp.Message = "成功"

	log.Printf("玩家离开房间成功 - 玩家: %s, 房间ID: %s", req.Head.PlayerId, leaveReq.RoomId)
	return resp, nil
}

// handleDestroyRoom 处理销毁房间
func (h *GameHandler) handleDestroyRoom(req *pb.GameMessage, resp *pb.GameMessageResponse) (*pb.GameMessageResponse, error) {
	var destroyReq pb.DestroyRoomRequest
	if err := proto.Unmarshal(req.Payload, &destroyReq); err != nil {
		resp.Code = 400
		resp.Message = "参数解析失败"
		return resp, nil
	}

	// 销毁房间
	err := h.roomManager.DestroyRoom(req.Head.PlayerId, destroyReq.RoomId)
	if err != nil {
		resp.Code = 500
		resp.Message = err.Error()
		return resp, nil
	}

	// 构造响应
	destroyResp := &pb.DestroyRoomResponse{
		Success: true,
		Message: "房间销毁成功",
	}

	payload, _ := proto.Marshal(destroyResp)
	resp.Code = 0
	resp.Payload = payload
	resp.Message = "成功"

	log.Printf("房间销毁成功 - 玩家: %s, 房间ID: %s", req.Head.PlayerId, destroyReq.RoomId)
	return resp, nil
}

// handlePlacePiece 处理下棋
func (h *GameHandler) handlePlacePiece(req *pb.GameMessage, resp *pb.GameMessageResponse) (*pb.GameMessageResponse, error) {
	var placeReq pb.PlacePieceRequest
	if err := proto.Unmarshal(req.Payload, &placeReq); err != nil {
		resp.Code = 400
		resp.Message = "参数解析失败"
		return resp, nil
	}

	// 先获取房间信息，用于后续推送消息
	targetRoom := h.roomManager.GetRoom(placeReq.RoomId)
	if targetRoom == nil {
		resp.Code = 404
		resp.Message = "房间不存在"
		return resp, nil
	}

	// 下棋
	game, err := h.roomManager.PlacePiece(req.Head.PlayerId, placeReq.RoomId, placeReq.X, placeReq.Y)
	if err != nil {
		resp.Code = 500
		resp.Message = err.Error()
		return resp, nil
	}

	// 构造响应
	placeResp := &pb.PlacePieceResponse{
		Success:   true,
		Message:   "下棋成功",
		GameState: game.GetGameState(),
	}

	payload, _ := proto.Marshal(placeResp)
	resp.Code = 0
	resp.Payload = payload
	resp.Message = "成功"

	log.Printf("下棋成功 - 玩家: %s, 房间ID: %s, 位置: (%d,%d)",
		req.Head.PlayerId, placeReq.RoomId, placeReq.X, placeReq.Y)

	// 【新增】推送消息给房间内其他玩家
	go h.notifyOtherPlayers(targetRoom, req.Head.PlayerId, placeResp)

	return resp, nil
}

// notifyOtherPlayers 通知房间内其他玩家
func (h *GameHandler) notifyOtherPlayers(room *room.Room, currentPlayerID string, placeResp *pb.PlacePieceResponse) {
	// 获取房间内除当前玩家外的其他玩家
	otherPlayers := room.GetOtherPlayers(currentPlayerID)

	if len(otherPlayers) == 0 {
		log.Printf("房间 %s 没有其他玩家需要通知", room.ID)
		return
	}

	// 构造通知消息
	notificationMsg := map[string]interface{}{
		"type":       "piece_placed",
		"room_id":    room.ID,
		"player_id":  currentPlayerID, // 谁下的棋
		"game_state": placeResp.GameState,
		"message":    placeResp.Message,
		"timestamp":  time.Now().UnixMilli(),
	}

	// 推送消息给其他玩家
	for _, playerID := range otherPlayers {
		notification.PushToPlayer(playerID, notificationMsg, "PiecePlacedNotification")
		log.Printf("推送下棋通知 - 目标玩家: %s, 下棋玩家: %s, 房间: %s",
			playerID, currentPlayerID, room.ID)
	}

	// 如果游戏结束，推送游戏结束通知
	if placeResp.GameState.Result != pb.GameResult_ONGOING {
		h.notifyGameOver(room, placeResp.GameState)
	}
}

// notifyGameOver 通知游戏结束
func (h *GameHandler) notifyGameOver(room *room.Room, gameState *pb.GameState) {
	allPlayers := room.GetAllPlayers()

	if len(allPlayers) == 0 {
		return
	}

	// 构造游戏结束通知
	gameOverMsg := map[string]interface{}{
		"type":       "game_over",
		"room_id":    room.ID,
		"winner_id":  gameState.WinnerId,
		"result":     gameState.Result,
		"game_state": gameState,
		"timestamp":  time.Now().UnixMilli(),
	}

	// 推送给所有玩家
	for _, playerID := range allPlayers {
		notification.PushToPlayer(playerID, gameOverMsg, "GameOverNotification")
		log.Printf("推送游戏结束通知 - 玩家: %s, 房间: %s, 获胜者: %s",
			playerID, room.ID, gameState.WinnerId)
	}
}

// handleGetRoomList 处理获取房间列表
func (h *GameHandler) handleGetRoomList(req *pb.GameMessage, resp *pb.GameMessageResponse) (*pb.GameMessageResponse, error) {
	var listReq pb.GetRoomListRequest
	if err := proto.Unmarshal(req.Payload, &listReq); err != nil {
		resp.Code = 400
		resp.Message = "参数解析失败"
		return resp, nil
	}

	// 设置默认值
	if listReq.Page <= 0 {
		listReq.Page = 1
	}
	if listReq.PageSize <= 0 {
		listReq.PageSize = 10
	}

	// 获取房间列表
	rooms, totalCount := h.roomManager.GetRoomList(listReq.Page, listReq.PageSize)

	// 转换为pb.RoomInfo
	roomInfos := make([]*pb.RoomInfo, 0, len(rooms))
	for _, room := range rooms {
		roomInfos = append(roomInfos, room.GetRoomInfo())
	}

	// 构造响应
	listResp := &pb.GetRoomListResponse{
		Success:    true,
		Rooms:      roomInfos,
		TotalCount: totalCount,
		Message:    "获取房间列表成功",
	}

	payload, _ := proto.Marshal(listResp)
	resp.Code = 0
	resp.Payload = payload
	resp.Message = "成功"

	log.Printf("获取房间列表成功 - 玩家: %s, 页码: %d, 数量: %d",
		req.Head.PlayerId, listReq.Page, len(rooms))
	return resp, nil
}

// handleStartGame 处理开始游戏
func (h *GameHandler) handleStartGame(req *pb.GameMessage, resp *pb.GameMessageResponse) (*pb.GameMessageResponse, error) {
	var startReq pb.StartGameRequest
	if err := proto.Unmarshal(req.Payload, &startReq); err != nil {
		resp.Code = 400
		resp.Message = "参数解析失败"
		return resp, nil
	}

	// 开始游戏
	err := h.roomManager.StartGame(req.Head.PlayerId, startReq.RoomId)
	if err != nil {
		resp.Code = 500
		resp.Message = err.Error()
		return resp, nil
	}

	// 获取游戏状态
	room := h.roomManager.GetRoom(startReq.RoomId)
	if room == nil {
		resp.Code = 500
		resp.Message = "房间不存在"
		return resp, nil
	}

	// 构造响应
	startResp := &pb.StartGameResponse{
		Success:   true,
		Message:   "游戏开始",
		GameState: room.Game.GetGameState(),
	}

	payload, _ := proto.Marshal(startResp)
	resp.Code = 0
	resp.Payload = payload
	resp.Message = "成功"

	log.Printf("游戏开始成功 - 玩家: %s, 房间ID: %s", req.Head.PlayerId, startReq.RoomId)
	return resp, nil
}

// notifyPlayerJoined 通知玩家加入房间
func (h *GameHandler) notifyPlayerJoined(room *room.Room, joinedPlayerID string) {
	// 获取房间内除加入玩家外的其他玩家
	otherPlayers := room.GetOtherPlayers(joinedPlayerID)

	if len(otherPlayers) == 0 {
		log.Printf("房间 %s 没有其他玩家需要通知玩家加入", room.ID)
		return
	}

	// 构造通知消息
	notificationMsg := map[string]interface{}{
		"type":             "player_joined",
		"room_id":          room.ID,
		"joined_player_id": joinedPlayerID,
		"room_info":        room.GetRoomInfo(), // 包含最新的房间信息
		"timestamp":        time.Now().UnixMilli(),
	}

	// 推送消息给其他玩家
	for _, playerID := range otherPlayers {
		notification.PushToPlayer(playerID, notificationMsg, "PlayerJoinedNotification")
		log.Printf("推送玩家加入通知 - 目标玩家: %s, 加入玩家: %s, 房间: %s",
			playerID, joinedPlayerID, room.ID)
	}
}

// notifyPlayerLeft 通知玩家离开房间
func (h *GameHandler) notifyPlayerLeft(room *room.Room, leftPlayerID string) {
	// 获取房间内除离开玩家外的其他玩家
	otherPlayers := room.GetOtherPlayers(leftPlayerID)

	if len(otherPlayers) == 0 {
		log.Printf("房间 %s 没有其他玩家需要通知玩家离开", room.ID)
		return
	}

	// 构造通知消息
	notificationMsg := map[string]interface{}{
		"type":           "player_left",
		"room_id":        room.ID,
		"left_player_id": leftPlayerID,
		"timestamp":      time.Now().UnixMilli(),
	}

	// 推送消息给其他玩家
	for _, playerID := range otherPlayers {
		notification.PushToPlayer(playerID, notificationMsg, "PlayerLeftNotification")
		log.Printf("推送玩家离开通知 - 目标玩家: %s, 离开玩家: %s, 房间: %s",
			playerID, leftPlayerID, room.ID)
	}
}

// 工具函数：将结构体转换为JSON字节数组
func structToBytes(data interface{}) []byte {
	bytes, _ := json.Marshal(data)
	return bytes
}
